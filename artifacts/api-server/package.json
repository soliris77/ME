{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "db:migrate": "node ./scripts/apply-migrations.mjs",
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run db:migrate && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/server/index.js",
    "start:web": "node --enable-source-maps ./dist/server/index.js",
    "start:worker": "node --enable-source-maps ./dist/worker/index.js",
    "deploy:worker": "pnpm run db:migrate && pnpm run start:worker",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:daily-loss": "tsx scripts/test-daily-loss.mjs",
    "test:daily-loss-warning": "tsx scripts/test-daily-loss-warning.mjs",
    "kraken:smoke": "tsx scripts/kraken-smoke.ts"
  },
  "dependencies": {
    "@whop/sdk": "^0.0.40",
    "@workspace/api-zod": "workspace:*",
    "@workspace/broker": "workspace:*",
    "@workspace/risk": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/indicators": "workspace:*",
    "@workspace/market-data": "workspace:*",
    "@workspace/scheduler": "workspace:*",
    "bcryptjs": "^3.0.3",
    "connect-pg-simple": "^10.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "express-session": "^1.19.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "resend": "^6.18.1",
    "snaptrade-typescript-sdk": "^10.0.18",
    "web-push": "^3.6.7",
    "yahoo-finance2": "^3.15.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/node": "catalog:",
    "@types/web-push": "^3.6.4",
    "esbuild": "0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0",
    "tsx": "^4.22.4",
    "vitest": "^4.1.10"
  }
}
