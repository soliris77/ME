modules = ["nodejs-20", "python-base-3.13", "postgresql-16"]

[[ports]]
localPort = 3001
externalPort = 3001

[[ports]]
localPort = 23051
externalPort = 80

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
